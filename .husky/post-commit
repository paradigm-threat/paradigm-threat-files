#!/usr/bin/env sh
set -e
# pre-commit runs *before* the commit exists, so generate-changelog's `git log`
# cannot see the commit being created — changelog.json would stay one behind.
# After commit, HEAD is correct; regenerate and amend into the same commit.
if [ "${PARADIGM_FILES_POST_COMMIT:-}" = "1" ]; then
  exit 0
fi
export PARADIGM_FILES_POST_COMMIT=1
cd "$(dirname "$0")/.." || exit 1
npm run autogen
git add index.json changelog.json
if git diff --cached --quiet; then
  exit 0
fi
git commit --amend --no-edit --no-verify
